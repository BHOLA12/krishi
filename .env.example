# Project Environment Variables
PROJECT_NAME="Krishi-Vani Core AI Backend"
ENV=development
DEBUG=true

# FastAPI Settings
API_V1_STR=/api/v1
SECRET_KEY=supersecretkeythatyoushouldchangeinproduction12345!

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=krishi_db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# External API Keys (Required for production integrations)
GEMINI_API_KEY=your_gemini_api_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_APP_ID=your_bhashini_app_id_here

# Telephony Configuration
BASE_URL=http://localhost:8000
TELEPHONY_PROVIDER=twilio

# Twilio API Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Exotel API Credentials
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=your_exotel_virtual_number_here

# Location Intelligence Default Fallbacks
DEFAULT_LATITUDE=25.611
DEFAULT_LONGITUDE=85.144
DEFAULT_DISTRICT=Patna
DEFAULT_STATE="Bihar"
DEFAULT_BLOCK="Phulwari Sharif"
